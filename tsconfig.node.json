{
  /* The end-to-end tests and their config run in Node, not the browser, so they
     get their own project: the root tsconfig deliberately sets `types: []` to
     keep Node globals out of the application source. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    /* Test files run in Node, but page.evaluate() callbacks are serialised and
       run in the browser, so they need the DOM lib to type-check. */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": ["tests", "playwright.config.ts"]
}
