{
  "name": "@adminlte/tailwind",
  "version": "0.2.0",
  "type": "module",
  "description": "AdminLTE dashboard template built with Tailwind CSS and @adminlte/headless",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check:avatars": "node scripts/generate-avatars.mjs --check",
    "gen:avatars": "node scripts/generate-avatars.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "keywords": [
    "adminlte",
    "tailwind",
    "tailwindcss",
    "dashboard",
    "admin",
    "template"
  ],
  "author": "AdminLTE.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColorlibHQ/adminlte-tailwind.git"
  },
  "bugs": {
    "url": "https://github.com/ColorlibHQ/adminlte-tailwind/issues"
  },
  "homepage": "https://adminlte.io",
  "dependencies": {
    "@adminlte/headless": "^0.1.0",
    "apexcharts": "^7.1.0",
    "jsvectormap": "^1.7.0",
    "simple-datatables": "^10.3.0"
  }
}
